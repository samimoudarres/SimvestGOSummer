# Copy to `.env` for local dev (never commit `.env`).
# Get a key from https://massive.com (Massive / Polygon-compatible stock API).
# Required in production (NODE_ENV=production) or when SIMVEST_REQUIRE_MASSIVE=1 —
# the API refuses to boot if missing. Local/dev without the flag warns but still starts.
MASSIVE_API_KEY=
# SIMVEST_REQUIRE_MASSIVE=1

# ─ Phase 3 production topology ─────────────────────────────────────────────
# After `npm run build`, serve the Vite client from Express alongside `/api` (single HTTPS origin).
# PowerShell: $env:SIMVEST_SERVE_DIST='true'; npx tsx server/index.ts
# SIMVEST_SERVE_DIST=true

# Client env (prefix VITE_) baked in at `vite build` time:
# Public origin where `/api/*` lives — leave unset for dev + same-origin deploys.
# Required for Capacitor when the UI loads from app WebView (non-http origin).
# Example: VITE_API_ORIGIN=https://app.yourdomain.com
# VITE_API_ORIGIN=
#
# Native store builds (recommended): copy `.env.capacitor.example` → `.env.capacitor`
# and run `npm run cap:sync:release` so the bundle always includes VITE_API_ORIGIN.
#
# Emulator / Simulator without VITE_API_ORIGIN: the app defaults to the host machine API
# (Android emulator: http://10.0.2.2:3001 — run `npm run dev:server`).
# Physical devices: set VITE_API_ORIGIN to http://<your-computer-LAN-IP>:3001 (and allow cleartext
# for that host in android/app/src/main/res/xml/network_security_config.xml), or use adb reverse.
#
# Android note: `VITE_API_ORIGIN=http://localhost:3001` (or 127.0.0.1) works on desktop but targets the
# phone itself on device — the app rewrites loopback → 10.0.2.2 automatically on Android native builds.

# Server JSON stores (legacy fallback when DATABASE_URL is unset). Local: `server/data/`.
# Render disk (optional rollback): SIMVEST_DATA_DIR=/var/data
# Media files live under `$SIMVEST_DATA_DIR/media` (or `server/data/media`) and are
# served at `/api/media/:id`. Prefer a persistent disk so attachments survive redeploys
# when Supabase Storage is unavailable.
# SIMVEST_DATA_DIR=

# Supabase / Postgres (preferred). See SUPABASE_SETUP_START_HERE.md
# Production: set DATABASE_URL to a direct Postgres connection (required).
# Advisory locks + normalized dual-write (ledger/feed). REST-only Supabase
# (service role without DATABASE_URL) does NOT provide locks — refuse that in prod.
# Keep a single API instance until Redis quotes exist — see docs/LAUNCH_TOPOLOGY.md.
# DATABASE_URL=postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=
#
# Feed/composer image durability: when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set,
# newly materialized images are also uploaded to Storage (bucket auto-created if missing).
# Clients keep using `/api/media/:id` — the API reads local disk first, then Storage.
# Local `$SIMVEST_DATA_DIR/media` (or `server/data/media`) is always written as fallback.
# Optional bucket name (default simvest-media):
# SIMVEST_MEDIA_BUCKET=simvest-media

# Browser CORS allowlist (comma-separated). Capacitor / missing Origin always allowed.
# Defaults include localhost Vite + capacitor://localhost. Add your production web origin:
# CORS_ORIGINS=https://app.yourdomain.com,https://www.yourdomain.com
# CORS_ORIGINS=

# Admin dashboard at /admin (read-only). Requires at least 8 characters.
# Send as header X-Simvest-Admin-Secret from the admin UI after sign-in.
# SIMVEST_ADMIN_SECRET=

# Opaque session tokens (login/signup). Stored hashed in auth-sessions.json /
# json_documents. Optional: SESSION_SECRET reserved for future signed JWTs;
# current design uses random opaque tokens (no signing secret required).
# SESSION_SECRET=

# Production: require Supabase/Postgres (fail boot if missing). Also implied
# when NODE_ENV=production.
# SIMVEST_REQUIRE_DB=1
# (Massive: see MASSIVE_API_KEY / SIMVEST_REQUIRE_MASSIVE at top of this file.)

# Dev only: allow X-Simvest-User-Id / ?uid= without Bearer (scripts, legacy).
# Production rejects header-only auth unless this is set.
# ALLOW_LEGACY_USER_HEADER=1

# Vite dev + preview: where `/api` is proxied (defaults http://127.0.0.1:3001).
# SIMVEST_API_PROXY_TARGET=http://127.0.0.1:3001

# Set to 1 to log snapshot/aggregate freshness + 429 backoffs from `server/massiveClient.ts` (stdout).
# Also run: npm run verify:massive-live
# MASSIVE_LIVE_TRACE=1
#
# Optional Web Push (author “Notify me”). Local: auto-generates vapid keys (file or DB).
# Production: set these explicitly (`npx web-push generate-vapid-keys`).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
#
# Native push (iOS/Android via Firebase Cloud Messaging). Paste full service-account JSON:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or mount a file path (local/docker only):
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json
#
# App Links / Universal Links well-known JSON (see docs/APP_LINKS.md):
# ANDROID_APP_LINK_SHA256=AB:CD:...   # Play App Signing SHA-256 (colon hex); comma-separated for multiple
# APPLE_TEAM_ID=XXXXXXXXXX            # Apple Developer Team ID for AASA appID

# App Links / Universal Links (join URLs on simvest-api.onrender.com) — see docs/APP_LINKS.md
# ANDROID_APP_LINK_SHA256=AA:BB:…   # Play Console → App integrity → App signing SHA-256 (required for Android verify)
# APPLE_TEAM_ID=XXXXXXXXXX          # Apple Developer Team ID (required for iOS AASA appID)

# ─ Hot-path JSON mirrors (OFF by default when using Postgres) ───────────────
# Leave unset in production. Enabling rewrites multi-MB json_documents on every
# trade/feed append and has caused Render memory-limit restarts.
# SIMVEST_FEED_JSON_MIRROR=1
# SIMVEST_LEDGER_JSON_MIRROR=1
